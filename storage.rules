rules_version = '2';

/**
 * ============================================================================
 * SANTER HUB — Security Rules do Cloud Storage
 * ============================================================================
 *
 * COMO PUBLICAR
 * -------------
 * Console do Firebase → Storage → aba "Rules" → cole este conteúdo → Publicar.
 * (Ou `firebase deploy --only storage`, se usar a CLI.)
 *
 * As capas dos eventos aparecem no site público, então a LEITURA é liberada.
 * A GRAVAÇÃO exige o mesmo login do painel — e valida tipo e tamanho aqui,
 * porque a checagem do formulário só existe na tela e pode ser contornada.
 * ============================================================================
 */

service firebase.storage {
  match /b/{bucket}/o {

    match /eventos/{arquivo} {
      allow read: if true;

      allow write: if request.auth != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|avif)');
    }

    // Nada fora da pasta de eventos.
    match /{caminho=**} {
      allow read, write: if false;
    }
  }
}
